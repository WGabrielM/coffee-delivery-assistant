{
  "name": "coffee-delivery-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Assistente de conhecimento do projeto Coffee Delivery: contexto estruturado, memória, camada de regras e RAG sobre documentos reais. Capstone do Módulo 3 (IA Aplicada).",
  "author": "Wellington Gabriel Monteiro Batista",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ingest": "node --env-file=.env.local src/ingest.ts",
    "ask": "node --env-file=.env.local src/ask.ts",
    "chat": "node --env-file=.env.local src/cli.ts",
    "demo": "node --env-file=.env.local src/demo.ts",
    "eval": "node --env-file=.env.local eval/run.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "openai": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
